# .NET
bin/
obj/
core/artifacts/
artifacts/
*.user
.vs/

# Unity project (the repo root IS the Unity project)
/Library/
/Temp/
/Obj/
/Build/
/Builds/
/Logs/
/UserSettings/
/.utmp/
/.gradle/
/*.csproj
/*.sln
unity-create.log

# Junction into core sources (tracked once under core/src; the junction
# path must not duplicate them). The .meta files Unity writes inside the
# junction are tracked via the core/src path.
/Assets/PuttSeedCore/src/

# Scaffolding for scripts\deploy-webgl.bat: the gh-pages worktree it checks
# out to copy the demo into. The script removes it on the way out; this is
# for the run that gets interrupted.
/.ghpages/

# Signing secrets — NEVER commit these
keystore.properties
*.keystore
*.jks

# Raw Game-view captures (PuttSeed -> Capture Screenshot). A shot earns a
# stable name in docs/media once it is curated into the README; everything
# still called shot-<timestamp> is a working file.
docs/media/shot-*.png

# OS
Thumbs.db
.DS_Store

# Icon candidates dropped in for comparison. The chosen artwork is committed
# as Assets/PuttSeed/Icon/artwork.png; these are the rejected auditions and a
# duplicate of the winner, and `git add -A` kept sweeping them into commits.
Assets/PuttSeed/Icon/ChatGPT*
Assets/PuttSeed/Icon/Gemini*
